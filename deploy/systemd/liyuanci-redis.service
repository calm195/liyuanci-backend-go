[Unit]
Description=Li Yuanci dedicated Redis
PartOf=liyuanci.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=lyc-redis
Group=lyc-redis
StateDirectory=liyuanci/redis
StateDirectoryMode=0700
ExecStart=/usr/bin/redis-server /etc/liyuanci/native/redis/redis.conf
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=4096
LogNamespace=liyuanci
Slice=liyuanci.slice
