[Unit]
Description=Li Yuanci lightweight health and backlog
After=liyuanci-business.target

[Service]
Type=oneshot
User=lyc-monitor
Group=lyc-monitor
EnvironmentFile=/etc/liyuanci/native/monitor/monitor.env
ExecStart=/bin/sh /opt/liyuanci/current/scripts/native-health.sh
TimeoutStartSec=45s
MemoryMax=48M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077
LimitNOFILE=4096
LogNamespace=liyuanci
Slice=liyuanci.slice
