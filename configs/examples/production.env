# 复制到.local/production/operations.env后编辑；字面KEY=value，不支持export/$变量/命令替换。
# 在独立生产Docker宿主使用真实文件，示例不包含凭据、不自动生成生产账号。
LIYUANCI_POSTGRES_PASSWORD_FILE=postgres-password
LIYUANCI_REDIS_ACL_FILE=redis.acl
LIYUANCI_MQ_ACL_FILE=plain_acl.yml
LIYUANCI_PGADMIN_EMAIL=operator@example.com
LIYUANCI_PGADMIN_PASSWORD_FILE=pgadmin-password
LIYUANCI_DASHBOARD_PROPERTIES_FILE=dashboard.properties
LIYUANCI_GRAFANA_PASSWORD_FILE=grafana-password
LIYUANCI_GRAFANA_ENCRYPTION_KEY_FILE=grafana-encryption-key
LIYUANCI_GRAFANA_ROOT_URL=http://127.0.0.1:13000/
LIYUANCI_LOG_HOST=production-node-1
LIYUANCI_LOG_RETENTION=336h
# 仅--middleware-metrics使用；先完成目标PG/Redis独立统计身份配置。
LIYUANCI_PG_MONITOR_PASSWORD_FILE=pg-monitor-password
LIYUANCI_REDIS_MONITOR_PASSWORDS_FILE=redis-monitor-passwords.json
# 仅--notifications使用；先交付真实渠道并单独验收。
LIYUANCI_ALERT_NOTIFICATIONS_FILE=notifications.yaml
