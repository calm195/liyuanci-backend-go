# 复制到.local/native/operations.env（目录0700）；按字面读取，不执行shell。
LIYUANCI_LOCAL_MIDDLEWARE=native
LIYUANCI_LOCAL_PROJECT=liyuanci-local-native
LIYUANCI_LOCAL_PG_PORT=5432
LIYUANCI_LOCAL_REDIS_PORT=6379
LIYUANCI_LOCAL_API_PORT=18080
# 本地PG管理员默认为当前宿主用户名；需要创建角色、数据库并显式授予迁移权限。
# LIYUANCI_NATIVE_PG_USER=postgres
# 可选口令文件路径相对operations.env解析；文件正文仅填口令。
# LIYUANCI_NATIVE_PG_PASSWORD_FILE=postgres-admin-password
# Redis使用默认ACL用户；无需口令时省略。
# LIYUANCI_NATIVE_REDIS_PASSWORD_FILE=redis-password
