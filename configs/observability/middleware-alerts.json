{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "liyuanci-middleware-alerts",
      "folder": "鲤源池运维",
      "interval": "20s",
      "rules": [
        {
          "uid": "liyuanci-pg-down",
          "title": "T004 PostgreSQL monitor connection failed",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "liyuanci-prometheus",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "pg_up",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "liyuanci-prometheus"
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "1m",
          "annotations": {
            "summary": "T004 PostgreSQL monitor connection failed",
            "runbook_url": "docs/observability.md"
          },
          "labels": {
            "task_id": "T004",
            "req": "REQ-020",
            "severity": "critical"
          },
          "isPaused": false
        },
        {
          "uid": "liyuanci-pg-scrape",
          "title": "T004 PostgreSQL scrape error",
          "condition": "C",
